# GEMINI_API_KEY: Required for optional Gemini AI features.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# FIREBASE WEB CONFIGURATION (Required for Production Authentication & Firestore)
# Obtain these values from your Firebase Console > Project Settings > General > Web Apps
# ==============================================================================
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="bright-sparkz-academy.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="bright-sparkz-academy"
VITE_FIREBASE_STORAGE_BUCKET="bright-sparkz-academy.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
